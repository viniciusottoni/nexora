{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/game/**",
              "player-screen/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Chakra Petch|Sora|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Chakra Petch, Sora, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|rank|online|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, rank, online."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='rank'] > Literal[value!=/^(?:E|D|C|B|A|S|SS|SSS)$/]",
        "message": "<Avatar> rank must be one of 'E' | 'D' | 'C' | 'B' | 'A' | 'S' | 'SS' | 'SSS'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|variant|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, variant, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|purple|gold|green|red|cyan|neutral)$/]",
        "message": "<Badge> tone must be one of 'blue' | 'purple' | 'gold' | 'green' | 'red' | 'cyan' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid|outline)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|glow|fullWidth|disabled|leftIcon|rightIcon|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, glow, fullWidth, disabled, leftIcon, rightIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|gold|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'gold' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|rank|interactive|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, variant, rank, interactive, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|energy|glow)$/]",
        "message": "<Card> variant must be one of 'default' | 'energy' | 'glow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='rank'] > Literal[value!=/^(?:E|D|C|B|A|S|SS|SSS)$/]",
        "message": "<Card> rank must be one of 'E' | 'D' | 'C' | 'B' | 'A' | 'S' | 'SS' | 'SSS'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|icon|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, selected, icon, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|leftIcon|rightSlot|hint|error|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, leftIcon, rightSlot, hint, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|stroke|color|trackColor|label|sublabel|children|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: value, max, size, stroke, color, trackColor, label, sublabel, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|xp|attr|rewards|status|icon|onToggle|key|ref|className|style|children)$/]",
        "message": "<QuestCard> doesn't accept that prop. Declared props: title, subtitle, xp, attr, rewards, status, icon, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestCard'] > JSXAttribute[name.name='attr'] > Literal[value!=/^(?:strength|agility|endurance|vitality|focus|wisdom)$/]",
        "message": "<QuestCard> attr must be one of 'strength' | 'agility' | 'endurance' | 'vitality' | 'focus' | 'wisdom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:todo|active|done)$/]",
        "message": "<QuestCard> status must be one of 'todo' | 'active' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RankBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:rank|size|glow|key|ref|className|style|children)$/]",
        "message": "<RankBadge> doesn't accept that prop. Declared props: rank, size, glow."
      },
      {
        "selector": "JSXOpeningElement[name.name='RankBadge'] > JSXAttribute[name.name='rank'] > Literal[value!=/^(?:E|D|C|B|A|S|SS|SSS)$/]",
        "message": "<RankBadge> rank must be one of 'E' | 'D' | 'C' | 'B' | 'A' | 'S' | 'SS' | 'SSS'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:attr|value|max|label|key|ref|className|style|children)$/]",
        "message": "<StatBar> doesn't accept that prop. Declared props: attr, value, max, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBar'] > JSXAttribute[name.name='attr'] > Literal[value!=/^(?:strength|agility|endurance|vitality|focus|wisdom)$/]",
        "message": "<StatBar> attr must be one of 'strength' | 'agility' | 'endurance' | 'vitality' | 'focus' | 'wisdom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SystemWindowGoal'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|current|target|unit|done|key|ref|className|style|children)$/]",
        "message": "<SystemWindowGoal> doesn't accept that prop. Declared props: label, current, target, unit, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='XPBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|level|showValues|height|key|ref|className|style|children)$/]",
        "message": "<XPBar> doesn't accept that prop. Declared props: value, max, level, showValues, height."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
